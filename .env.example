# Copy to .env.local and fill in. Server-side only — never referenced from a client component.
# PLACEHOLDERS ONLY. Never put real credentials in this file; it is committed to git.

# OpenAI — structured extraction and the three concurrent checks
OPENAI_API_KEY=
# Optional. Leave blank to use gpt-4o-mini for OpenAI keys or claude-sonnet-4-5 for Anthropic keys.
OPENAI_MODEL=

# Vapi — outbound voice callback. Omit to run in findings-only mode.
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Sarah's allow-listed destination number in E.164 form, e.g. +14085550123.
# Server-side only; never sent to the browser.
SARAH_PHONE_NUMBER=

# Set to "true" to force the verified demo fallback without any network calls.
DEMO_SAFE_MODE=false
